# Serves the Angular app and forwards /api to the gateway, so the browser sees a single origin
# (session cookie and XSRF-TOKEN cookie work without cross-site CORS).
# API_URL and PORT come from the environment (envsubst by the nginx image at startup).
server {
    listen ${PORT};
    listen [::]:${PORT};
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${API_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    # Angular routes: unknown paths load the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
