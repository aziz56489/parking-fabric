{
  "uid": "parking-microservices",
  "title": "Parking - Microservices",
  "tags": ["parking", "spring-boot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Services up",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job!=\"tempo\"}", "legendFormat": "{{job}}", "instant": true }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "HTTP requests per second (by service)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[1m]))", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "Latency p95 (by service) - exemplars link to Tempo",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "exemplar": true, "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[5m])))", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "HTTP errors (4xx / 5xx per second)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))", "legendFormat": "5xx {{application}}" },
        { "refId": "B", "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"4..\"}[1m]))", "legendFormat": "4xx {{application}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Top endpoints (requests per second)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "topk(8, sum by (application, method, uri) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*|/metrics\"}[5m])))", "legendFormat": "{{application}} {{method}} {{uri}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 6, "type": "state-timeline", "title": "Circuit breaker parkingService (notification-service)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "max by (state) (resilience4j_circuitbreaker_state{name=\"parkingService\"})", "legendFormat": "{{state}}" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "type": "value", "options": { "0": { "text": "-", "color": "transparent" }, "1": { "text": "active", "color": "orange" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 1 }] }
        }
      }
    },
    {
      "id": 7, "type": "timeseries", "title": "Circuit breaker calls (by outcome) and failure rate",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (kind) (rate(resilience4j_circuitbreaker_calls_seconds_count{name=\"parkingService\"}[1m]))", "legendFormat": "{{kind}}" },
        { "refId": "B", "expr": "sum by (kind) (rate(resilience4j_circuitbreaker_not_permitted_calls_total{name=\"parkingService\"}[1m]))", "legendFormat": "not permitted (open)" },
        { "refId": "C", "expr": "resilience4j_circuitbreaker_failure_rate{name=\"parkingService\"}", "legendFormat": "failure rate %" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Kafka: messages sent / consumed per second",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (application) (rate(spring_kafka_template_seconds_count[1m]))", "legendFormat": "sent by {{application}}" },
        { "refId": "B", "expr": "sum by (application) (rate(spring_kafka_listener_seconds_count[1m]))", "legendFormat": "consumed by {{application}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Outgoing HTTP calls (Feign, Open-Meteo) - p95",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, application, client_name) (rate(http_client_requests_seconds_bucket[5m])))", "legendFormat": "{{application}} -> {{client_name}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "JVM heap used",
      "gridPos": { "x": 0, "y": 33, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{application}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "CPU usage (process)",
      "gridPos": { "x": 12, "y": 33, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "process_cpu_usage", "legendFormat": "{{application}}" },
        { "refId": "B", "expr": "rate(process_cpu_seconds_total{job=\"billing-service\"}[1m])", "legendFormat": "billing-service" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 12, "type": "table", "title": "Recent traces (Tempo) - click a trace ID to open it",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 9 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "refId": "A", "queryType": "traceql", "query": "{ resource.service.name =~ \"gateway-service|parking-service|notification-service\" }", "limit": 20, "tableType": "traces" }]
    },
    {
      "id": 13, "type": "nodeGraph", "title": "Service map (from traces)",
      "gridPos": { "x": 0, "y": 49, "w": 24, "h": 10 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [{ "refId": "A", "queryType": "serviceMap" }]
    }
  ]
}
